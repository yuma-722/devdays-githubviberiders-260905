# フロントエンド環境変数のサンプル（機密情報は含めないこと）
# 実際に使う場合は .env.local などにコピーして値を設定してください。

# API のベース URL（/api まで含める）。
# 未設定時は同一オリジンの /api を使用します（開発時は Vite プロキシ経由、SWA では同一オリジン）。
# 例: バックエンドが別オリジンの場合
# VITE_API_BASE_URL=https://func-devdays-survey.azurewebsites.net/api
VITE_API_BASE_URL=

# 開発サーバー (npm run dev) の /api プロキシ先。既定は http://127.0.0.1:7071
# テスト用の専用ポートへ切り替える場合に設定します。
# API_PROXY_TARGET=http://127.0.0.1:7171
